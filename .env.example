# Service machine OBS WebSocket. Copy this file to .env and fill the password
# from OBS: Tools → WebSocket Server Settings → Show Connect Info.
OBS_HOST=10.1.10.167
OBS_PORT=4455
OBS_PASSWORD=

# Watching only. Set to true before an Apply button may change OBS.
ALLOW_APPLY=false

BOOTH_HOST=127.0.0.1
BOOTH_PORT=8765
POLL_SECONDS=2

# Optional. When this is empty, fault text comes from the detector.
GOOGLE_API_KEY=

# Behringer X32 OSC. Leave empty to watch OBS only.
# This connection is read-only. OBS still receives one Microphone (X-USB) feed.
X32_HOST=
X32_PORT=10023
